# ─────────────────────────────────────────────────────────────────────
# TuCancha — configuración para desarrollo local con Docker
#
# El entrypoint copia este archivo a .env automáticamente la primera vez
# que levantás el proyecto, y genera la APP_KEY.
#
# NUNCA commitear el .env real. Este archivo es sólo la plantilla.
# ─────────────────────────────────────────────────────────────────────

APP_NAME=TuCancha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos ────────────────────────────────────────────────────
# El host es "db" (nombre del servicio en docker-compose), no 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tucancha
DB_USERNAME=tucancha
DB_PASSWORD=secret

# ── Sesiones / cache / colas ─────────────────────────────────────────
# Todo va a la base de datos (igual que producción, no usamos Redis).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────
# En desarrollo los mails NO se envían: se escriben en storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev@tucancha.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Websockets (Reverb) ──────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tucancha-local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
# El servidor escucha dentro de la red de Docker...
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOSTNAME=0.0.0.0
# ...y el navegador se conecta desde el host.
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ─────────────────────────────────────────────────────────────────────
# Servicios externos — OPCIONALES en desarrollo.
# La app arranca y funciona sin estas claves. Completalas sólo si vas a
# trabajar puntualmente en pagos, login con Google o mapas.
# ─────────────────────────────────────────────────────────────────────

# Pagos (usar credenciales de PRUEBA de Mercado Pago, nunca las de producción)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# Login con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Mapas y geocoding
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Notificaciones push (generar con: php artisan webpush:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@tucancha.local

# Otros
GEMINI_API_KEY=
N8N_NEW_USER_WEBHOOK=
N8N_INSTAGRAM_WEBHOOK=
